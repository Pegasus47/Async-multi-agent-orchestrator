# ==============================================================================
# Async Multi-Agent Orchestrator - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*~

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py.cover
htmlcov/
.hypothesis/

# Linters, Type Checkers & Tooling
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
.cache/

# Jupyter & IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vite / React / Tailwind)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build outputs
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
dist-ssr/

# Tooling caches
.eslintcache
.stylelintcache
.vite/

# ------------------------------------------------------------------------------
# Project Specific (Orchestrator Run Artifacts & Databases)
# ------------------------------------------------------------------------------
# Workspaces generated per agent run
workspaces/

# Generated reports & outputs
last_run_report*.json
site_output/

# SQLite databases & runtime storage
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
*.sqlite3
*.db
!data/.gitkeep

# Application logs
*.log
logs/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
tempCodeRunnerFile.*

# ------------------------------------------------------------------------------
# Slurm job outputs and error files
# ------------------------------------------------------------------------------
slurm.*.out
slurm.*.err
